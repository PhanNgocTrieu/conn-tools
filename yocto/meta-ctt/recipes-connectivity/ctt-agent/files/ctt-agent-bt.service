[Unit]
Description=CTT agent: Bluetooth RFCOMM throughput endpoint (channel 22)
Documentation=https://github.com/PhanNgocTrieu/conn-tools
# bt-daemon powers the adapter; start after it so channel 22 is bound on a live controller.
After=bluetooth.service bt-daemon.service
Wants=bluetooth.service

[Service]
# Serves one CTP session after another for ctt-agent.exe / ctt-agent-console.exe on the PC
# (ctt-agent-console run --addr <board BT address> --channel 22). Channel 22 stays clear of
# the low channels used by BlueZ profiles and iAP2.
# -i 1: one trace line per second (sent / received so far): journalctl -f -u ctt-agent-bt
ExecStart=/usr/bin/ctt-agent server -t rfcomm -e /22 -i 1 --timeout 30
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
